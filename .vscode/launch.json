{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "cwd": "${fileDirname}",
            "environment": [{ "name": "DISPLAY", "value": ":0" }], // imshow opens on the VM desktop, ssh has no display
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "make",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "python\ntry:\n    gdb.execute('set args ' + open('${fileDirname}/args.txt').read().strip())\nexcept FileNotFoundError:\n    pass", "ignoreFailures": true }
            ]
        }
    ]
}
